PORT=3000
NODE_ENV=production
DATA_DIR=./data
# Supabase Postgres connection string — Project Settings > Database > Connection string (URI, use the "Session pooler" one)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
OWNER_USERNAME=parham-savar
OWNER_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
SESSION_DAYS=14
# AI providers — keep ALL keys server-side, never in js/app.js
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-4
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
